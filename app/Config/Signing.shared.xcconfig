// No upstream team or certificate is inherited by Remy.
// The local build helper disables signing unless explicitly overridden.
// A distributable Release build requires the owner's own signing identity.
// Release identity can be pinned to a certificate SHA-1 in Signing.local.xcconfig.
DEVELOPER_ID_APPLICATION_IDENTITY = Developer ID Application
#include? "Signing.local.xcconfig"

// Create Config/Signing.local.xcconfig on your machine and set:
// DEVELOPMENT_TEAM = YOUR_TEAM_ID
// DEVELOPER_ID_APPLICATION_IDENTITY = YOUR_CERTIFICATE_SHA1
