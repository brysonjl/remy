<UserControl x:Class="Remy.App.Overlay.OverlayPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Remy.App.Overlay"
             xmlns:c="clr-namespace:Remy.App.Controls"
             UseLayoutRounding="True" SnapsToDevicePixels="True" Focusable="False" IsHitTestVisible="False">
  <!-- Ov.* brushes are written by OverlayPalette.Apply into this control's Resources. -->
  <Grid x:Name="CanvasGrid">
    <Border x:Name="Pill" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10" Width="340"
            Background="{DynamicResource Ov.Surface}" BorderBrush="{DynamicResource Ov.Edge}" BorderThickness="1.25" CornerRadius="16"
            RenderTransformOrigin="0.5,1">
      <Border.RenderTransform><ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
      <Border.Effect><DropShadowEffect x:Name="PillShadow" Color="Black" Opacity="0.34" BlurRadius="8" ShadowDepth="4" Direction="270"/></Border.Effect>
      <Grid x:Name="ContentGrid" ClipToBounds="True">

        <!-- Listening with text preview -->
        <StackPanel x:Name="ListenText" Visibility="Collapsed">
          <Grid x:Name="HeaderRow">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Rectangle x:Name="HeaderMark" Fill="{DynamicResource Ov.Accent}" Width="16" Height="16" VerticalAlignment="Center"/>
              <c:TrackedText x:Name="HeaderLabel" Text="Listening" FontSize="9" Tracking="1" Foreground="{DynamicResource Ov.Secondary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Ellipse Grid.Column="2" Width="4" Height="4" Fill="{DynamicResource Ov.Warm}" VerticalAlignment="Center"/>
          </Grid>
          <o:BottomAnchoredPanel x:Name="TextViewport">
            <TextBlock x:Name="TranscriptBlock" TextWrapping="Wrap" TextTrimming="None" HorizontalAlignment="Stretch"/>
          </o:BottomAnchoredPanel>
          <o:WaveformView x:Name="WaveA" Tint="{DynamicResource Ov.Accent}" Height="16"/>
        </StackPanel>

        <!-- Listening, waveform only -->
        <Grid x:Name="ListenWave" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Rectangle x:Name="WaveMark" Fill="{DynamicResource Ov.Accent}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <o:WaveformView x:Name="WaveB" Grid.Column="1" Tint="{DynamicResource Ov.Accent}" VerticalAlignment="Center"/>
        </Grid>

        <!-- Processing / success badge -->
        <Grid x:Name="ProcessingBadge" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
          <o:SpinnerView Tint="{DynamicResource Ov.Accent}"/>
        </Grid>
        <Grid x:Name="SuccessBadge" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
          <o:SuccessView x:Name="SuccessAnim" Tint="{DynamicResource Ov.Success}" CheckBack="{DynamicResource Ov.Surface}"/>
        </Grid>

        <!-- Copy only -->
        <StackPanel x:Name="CopyPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
          <TextBlock Text="&#xE77F;" FontFamily="{StaticResource Font.Icons}" FontSize="12.5" Foreground="{DynamicResource Ov.Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock x:Name="CopyText" FontFamily="{StaticResource Font.Display}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Ov.Text}" Opacity="0.9" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Error / cleanup fallback -->
        <StackPanel x:Name="ErrorPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0" Visibility="Collapsed">
          <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Font.Icons}" FontSize="13" Foreground="{DynamicResource Ov.Warm}" VerticalAlignment="Center" Margin="0,0,7,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="ErrorTitle" FontFamily="{StaticResource Font.Ui}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Ov.Text}" TextTrimming="CharacterEllipsis" MaxWidth="250"/>
            <TextBlock x:Name="ErrorDetailText" FontFamily="{StaticResource Font.Ui}" FontSize="10.5" Foreground="{DynamicResource Ov.Secondary}" TextTrimming="CharacterEllipsis" MaxWidth="250" Margin="0,3,0,0"/>
          </StackPanel>
        </StackPanel>

        <!-- Spinner + text: cleaning, preparing, busy -->
        <StackPanel x:Name="SpinnerText" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0" Visibility="Collapsed">
          <o:SpinnerView Tint="{DynamicResource Ov.Accent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="SpinnerLabel" FontFamily="{StaticResource Font.Display}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Ov.Text}" Opacity="0.9"
                     TextWrapping="Wrap" MaxWidth="210" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Hold to cancel -->
        <StackPanel x:Name="CancelPanel" VerticalAlignment="Center" Margin="16,0" Visibility="Collapsed">
          <TextBlock Text="Hold to cancel" FontFamily="{StaticResource Font.Ui}" FontSize="10.1" FontWeight="Medium" Foreground="{DynamicResource Ov.Text}" Margin="0,0,0,5"/>
          <Grid Height="3">
            <Border CornerRadius="1.5" Background="{DynamicResource Ov.Text}" Opacity="0.18"/>
            <Border x:Name="CancelFill" CornerRadius="1.5" Background="{DynamicResource Ov.Text}" HorizontalAlignment="Left" Width="0"/>
          </Grid>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
