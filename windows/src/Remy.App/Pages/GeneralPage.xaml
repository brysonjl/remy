<UserControl x:Class="Remy.App.Pages.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Remy.App.Controls"
             xmlns:p="clr-namespace:Remy.App.Pages">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
    <p:NotEmptyToVisibilityConverter x:Key="NotEmptyVis"/>
    <Style x:Key="Gap" TargetType="FrameworkElement"><Setter Property="Margin" Value="24,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="Sw" TargetType="ToggleButton" BasedOn="{StaticResource Remy.Switch}">
      <Setter Property="Margin" Value="24,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <DataTemplate x:Key="SoundRow" DataType="{x:Type p:SoundPickerViewModel}">
      <StackPanel>
        <Grid Margin="16,13,16,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.RowLabel}" VerticalAlignment="Center"/>
          <ComboBox Grid.Column="1" Width="190" ItemsSource="{Binding Options}" SelectedValuePath="Value" DisplayMemberPath="Label"
                    SelectedValue="{Binding SelectedId, Mode=TwoWay}" AutomationProperties.Name="{Binding AutomationName}"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="16,0,16,14">
          <Button Content="Import audio…" Command="{Binding ImportCommand}" IsEnabled="{Binding CanImport}" AutomationProperties.Name="{Binding ImportName}"/>
          <Button Content="Preview" Command="{Binding PreviewCommand}" IsEnabled="{Binding CanPreview}" Margin="10,0,0,0" AutomationProperties.Name="{Binding PreviewName}"/>
          <TextBlock Text="Importing…" Style="{StaticResource Text.Caption}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding Importing, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Importing audio"/>
        </StackPanel>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <c:PageScaffold Title="General" Subtitle="How Remy starts, looks, sounds, and listens.">
    <StackPanel>
      <!-- Startup -->
      <c:Section Overline="Startup">
        <Border Style="{StaticResource Remy.Card}">
          <StackPanel>
            <Border Style="{StaticResource Remy.Row}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Launch at login" Style="{StaticResource Text.RowLabel}" VerticalAlignment="Center"/>
                <ToggleButton Grid.Column="1" Style="{StaticResource Sw}" IsChecked="{Binding LaunchAtLogin, Mode=TwoWay}" AutomationProperties.Name="Launch at login"/>
              </Grid>
            </Border>
            <p:FieldMessage Text="{Binding LaunchAtLoginError}" Tone="Error" Margin="16,0,16,10"/>
            <Border Style="{StaticResource Remy.Divider}"/>
            <Border Style="{StaticResource Remy.Row}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="App appears in" Style="{StaticResource Text.RowLabel}" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" Style="{StaticResource Remy.ComboBox}" ItemsSource="{Binding AppearanceOptions}" SelectedValuePath="Value" DisplayMemberPath="Label"
                          SelectedValue="{Binding AppAppearance, Mode=TwoWay}" AutomationProperties.Name="App appears in"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource Remy.Divider}"/>
            <Border Style="{StaticResource Remy.DetailRow}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Prepare models ahead of time" Style="{StaticResource Text.RowLabel}" VerticalAlignment="Center"/>
                  <ToggleButton Grid.Column="1" Style="{StaticResource Sw}" IsChecked="{Binding PrewarmEnginesAtStartup, Mode=TwoWay}" AutomationProperties.Name="Prepare models ahead of time"/>
                </Grid>
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,70,0"
                           Text="Warm selected models at launch and when cleanup is enabled. Uses more memory to avoid first-use loading."/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </c:Section>

      <!-- Display -->
      <c:Section Overline="Display">
        <Border Style="{StaticResource Remy.Card}">
          <Border Style="{StaticResource Remy.DetailRow}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Theme" Style="{StaticResource Text.RowLabel}" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedValuePath="Value" DisplayMemberPath="Label"
                          SelectedValue="{Binding Theme, Mode=TwoWay}" AutomationProperties.Name="Theme"/>
              </Grid>
              <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" Text="System follows your Windows appearance setting."/>
            </StackPanel>
          </Border>
        </Border>
      </c:Section>

      <!-- Text destination -->
      <c:Section Overline="Text destination">
        <Border Style="{StaticResource Remy.Card}">
          <StackPanel>
            <Border Style="{StaticResource Remy.Row}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Send dictated text to" Style="{StaticResource Text.RowLabel}" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding DestinationOptions}" SelectedValuePath="Value" DisplayMemberPath="Label"
                          SelectedValue="{Binding Destination, Mode=TwoWay}" AutomationProperties.Name="Send dictated text to"/>
              </Grid>
            </Border>
            <p:Hint Text="{Binding DestinationHint}" Margin="16,0,16,14"/>
          </StackPanel>
        </Border>
      </c:Section>

      <!-- Language -->
      <c:Section Overline="Language">
        <Border Style="{StaticResource Remy.Card}">
          <Border Style="{StaticResource Remy.DetailRow}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Expected language" Style="{StaticResource Text.RowLabel}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="English" Style="{StaticResource Text.RowValue}" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                         Text="Choose the expected language, then a compatible model on the Speech Model page. This model transcribes English. Choose another model for other languages."/>
            </StackPanel>
          </Border>
        </Border>
      </c:Section>

      <!-- Audio -->
      <c:Section Overline="Audio">
        <StackPanel>
        <Border Style="{StaticResource Remy.Card}">
          <StackPanel>
            <Border Style="{StaticResource Remy.Row}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Microphone" Style="{StaticResource Text.RowLabel}" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" MaxWidth="360" ItemsSource="{Binding Microphones}" SelectedValuePath="Value" DisplayMemberPath="Label"
                          SelectedValue="{Binding MicrophoneId, Mode=TwoWay}" AutomationProperties.Name="Microphone"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource Remy.Divider}"/>
            <Border Style="{StaticResource Remy.Row}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Boost microphone volume during recording" Style="{StaticResource Text.RowLabel}" VerticalAlignment="Center"/>
                <ToggleButton Grid.Column="1" Style="{StaticResource Sw}" IsChecked="{Binding BoostMicrophone, Mode=TwoWay}" AutomationProperties.Name="Boost microphone volume during recording"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource Remy.Divider}"/>
            <Border Style="{StaticResource Remy.Row}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Mute system audio during recording" Style="{StaticResource Text.RowLabel}" VerticalAlignment="Center"/>
                <ToggleButton Grid.Column="1" Style="{StaticResource Sw}" IsChecked="{Binding MuteSystemAudio, Mode=TwoWay}" AutomationProperties.Name="Mute system audio during recording"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource Remy.Divider}"/>
            <Border Style="{StaticResource Remy.Row}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Sound effects" Style="{StaticResource Text.RowLabel}" VerticalAlignment="Center"/>
                <ToggleButton Grid.Column="1" Style="{StaticResource Sw}" IsChecked="{Binding SoundEffects, Mode=TwoWay}" AutomationProperties.Name="Sound effects"/>
              </Grid>
            </Border>
            <StackPanel Visibility="{Binding SoundEffects, Converter={StaticResource BoolVis}}">
              <Border Style="{StaticResource Remy.Divider}"/>
              <ContentControl Content="{Binding StartSound}" ContentTemplate="{StaticResource SoundRow}"/>
              <p:FieldMessage Text="{Binding StartSound.Message}" Tone="Info" Margin="16,0,16,12"/>
              <Border Style="{StaticResource Remy.Divider}"/>
              <ContentControl Content="{Binding CompletionSound}" ContentTemplate="{StaticResource SoundRow}"/>
              <p:FieldMessage Text="{Binding CompletionSound.Message}" Tone="Info" Margin="16,0,16,12"/>
              <TextBlock Style="{StaticResource Text.Caption}" Margin="16,0,16,14"
                         Text="Import a local WAV or MP3 clip, up to 10 seconds and 10 MiB. Remy keeps its own copy; your original stays unchanged."/>
              <Border Style="{StaticResource Remy.Divider}"/>
              <Grid Margin="16,14" >
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE767;" Style="{StaticResource Text.Icon}" FontSize="12" VerticalAlignment="Center"/>
                <Slider Grid.Column="2" Minimum="0" Maximum="1" LargeChange="0.1" SmallChange="0.1" Value="{Binding SoundVolume, Mode=TwoWay}" VerticalAlignment="Center"
                        AutomationProperties.Name="Sound effects volume"/>
                <TextBlock Grid.Column="4" Text="&#xE995;" Style="{StaticResource Text.Icon}" FontSize="12" VerticalAlignment="Center"/>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>
        <p:Hint Margin="0,12,0,0" Text="Boosting raises low mic input, and muting keeps system audio out of your dictation."/>
        </StackPanel>
      </c:Section>
    </StackPanel>
  </c:PageScaffold>
</UserControl>
