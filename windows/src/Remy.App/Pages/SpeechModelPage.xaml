<UserControl x:Class="Remy.App.Pages.SpeechModelPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Remy.App.Controls"
             xmlns:p="clr-namespace:Remy.App.Pages">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
    <Style x:Key="Model.Progress" TargetType="ProgressBar">
      <Setter Property="Height" Value="5"/>
      <Setter Property="Maximum" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
        <Grid>
          <Border CornerRadius="3" Background="{DynamicResource Brush.SliderTrackRest}"/>
          <Border x:Name="PART_Track"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource Brush.Accent}"/></Border>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </UserControl.Resources>

  <c:PageScaffold Title="Speech Model" Subtitle="Speech recognition runs on your PC. Transcript cleanup uses the method you choose separately.">
    <StackPanel>
      <c:Section Overline="Active Engine">
        <Border Style="{StaticResource Remy.Card}">
          <Border Style="{StaticResource Remy.DetailRow}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Engine" Style="{StaticResource Text.RowLabel}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Parakeet v2" Style="{StaticResource Text.RowValue}" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" Text="{x:Static p:SpeechModelPageViewModel.ModelDetail}"/>
            </StackPanel>
          </Border>
        </Border>
      </c:Section>

      <c:Section Overline="On-Device Speech">
        <StackPanel>
          <Border Style="{StaticResource Remy.Card}">
            <StackPanel>
              <Border Style="{StaticResource Remy.DetailRow}">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Expected language" Style="{StaticResource Text.RowLabel}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="English" Style="{StaticResource Text.RowValue}" VerticalAlignment="Center"/>
                  </Grid>
                  <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                             Text="This model transcribes English. Choose another model for other languages."/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Remy.Divider}"/>
              <Border Style="{StaticResource Remy.DetailRow}">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Speech model" Style="{StaticResource Text.RowLabel}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Parakeet v2" Style="{StaticResource Text.RowValue}" VerticalAlignment="Center"/>
                  </Grid>
                  <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" Text="{x:Static p:SpeechModelPageViewModel.ModelDetail}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Remy.Divider}"/>
              <Border Style="{StaticResource Remy.Row}"><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Type" Style="{StaticResource Text.RowLabel}"/>
                <TextBlock Grid.Column="1" Text="On-device speech-to-text" Style="{StaticResource Text.RowValue}"/>
              </Grid></Border>
              <Border Style="{StaticResource Remy.Divider}"/>
              <Border Style="{StaticResource Remy.Row}"><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Underlying model" Style="{StaticResource Text.RowLabel}"/>
                <TextBlock Grid.Column="1" Text="NVIDIA Parakeet TDT 0.6B v2" Style="{StaticResource Text.RowValue}"/>
              </Grid></Border>
              <Border Style="{StaticResource Remy.Divider}"/>
              <Border Style="{StaticResource Remy.Row}"><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Languages" Style="{StaticResource Text.RowLabel}"/>
                <TextBlock Grid.Column="1" Text="English only" Style="{StaticResource Text.RowValue}"/>
              </Grid></Border>
              <Border Style="{StaticResource Remy.Divider}"/>
              <Border Style="{StaticResource Remy.Row}"><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Download size" Style="{StaticResource Text.RowLabel}"/>
                <TextBlock Grid.Column="1" Text="{x:Static p:SpeechModelPageViewModel.SizeText}" Style="{StaticResource Text.RowValue}"/>
              </Grid></Border>
              <Border Style="{StaticResource Remy.Divider}"/>

              <!-- Status row (DSModelReadinessRow) -->
              <Border Style="{StaticResource Remy.Row}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Status" Style="{StaticResource Text.RowLabel}" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsWorking, Converter={StaticResource BoolVis}}">
                      <p:Spinner Margin="0,0,8,0"/>
                      <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource Text.RowValue}" FontWeight="SemiBold" FontSize="12.5"/>
                    </StackPanel>
                    <c:StatusPill Text="{Binding StatusTitle}" VerticalAlignment="Center">
                      <c:StatusPill.Style>
                        <Style TargetType="c:StatusPill" BasedOn="{StaticResource {x:Type c:StatusPill}}">
                          <Setter Property="Visibility" Value="Visible"/><Setter Property="Kind" Value="Neutral"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWorking}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsReady}" Value="True"><Setter Property="Kind" Value="Ready"/></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </c:StatusPill.Style>
                    </c:StatusPill>
                    <Button Content="Download Model" Style="{StaticResource Remy.PrimaryButton}" Margin="10,0,0,0" Command="{Binding DownloadCommand}"
                            Visibility="{Binding CanDownload, Converter={StaticResource BoolVis}}"/>
                    <Button Content="Prepare Model" Style="{StaticResource Remy.PrimaryButton}" Margin="10,0,0,0" Command="{Binding PrepareCommand}"
                            Visibility="{Binding CanPrepare, Converter={StaticResource BoolVis}}"/>
                    <Button Content="Cancel" Margin="10,0,0,0" Command="{Binding CancelDownloadCommand}"
                            Visibility="{Binding CanCancel, Converter={StaticResource BoolVis}}"/>
                  </StackPanel>
                </Grid>
              </Border>
              <StackPanel Margin="16,0,16,10" Visibility="{Binding IsDownloading, Converter={StaticResource BoolVis}}">
                <ProgressBar Style="{StaticResource Model.Progress}" Value="{Binding ProgressValue, Mode=OneWay}" AutomationProperties.Name="{Binding ProgressName}"/>
                <TextBlock Text="{Binding ProgressCaption}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"/>
              </StackPanel>
              <p:FieldMessage Text="{Binding ErrorText}" Tone="Error" Margin="16,0,16,12"/>

              <StackPanel Visibility="{Binding ShowRemove, Converter={StaticResource BoolVis}}">
                <Border Style="{StaticResource Remy.Divider}"/>
                <Border Style="{StaticResource Remy.Row}"><Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Remove the downloaded model files from this PC." Style="{StaticResource Text.RowValue}" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Content="Delete Model…" Style="{StaticResource Remy.DestructiveButton}" Margin="24,0,0,0"
                          Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}"/>
                </Grid></Border>
              </StackPanel>
            </StackPanel>
          </Border>
          <p:Hint Margin="0,12,0,0" Text="Download size is not a memory estimate. The language and model you select are kept until you change them."/>
        </StackPanel>
      </c:Section>
    </StackPanel>
  </c:PageScaffold>
</UserControl>
