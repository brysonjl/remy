<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Remy.App.Controls">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Typography.xaml"/></ResourceDictionary.MergedDictionaries>
  <!-- Atoms and molecules from parity/ui.md 1.7 / 1.8. All colors are DynamicResource so the theme swaps live. -->

  <DropShadowEffect x:Key="Effect.Tactile" Color="#102838" Opacity="0.07" BlurRadius="2" ShadowDepth="2" Direction="270"/>
  <DropShadowEffect x:Key="Effect.Card" Color="#102838" Opacity="0.07" BlurRadius="6" ShadowDepth="3" Direction="270"/>

  <!-- ===== Button family (DSControlSurface: fill + 1px border + hover 5% / pressed 10% ink overlay, disabled 0.45) ===== -->
  <ControlTemplate x:Key="Remy.SurfaceTemplate" TargetType="ButtonBase">
    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="1" CornerRadius="{Binding Path=(c:Ui.Radius), RelativeSource={RelativeSource TemplatedParent}}"
            Effect="{StaticResource Effect.Tactile}" SnapsToDevicePixels="True">
      <Grid>
        <Border x:Name="Hover" Opacity="0" IsHitTestVisible="False" Background="{DynamicResource Brush.HoverOverlay}"
                CornerRadius="{Binding Path=(c:Ui.Radius), RelativeSource={RelativeSource TemplatedParent}}"/>
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
        <Border x:Name="Focus" BorderThickness="2" BorderBrush="{DynamicResource Brush.AccentDeep}" Visibility="Collapsed" Margin="-2"
                CornerRadius="{Binding Path=(c:Ui.Radius), RelativeSource={RelativeSource TemplatedParent}}" IsHitTestVisible="False"/>
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Hover" Property="Opacity" Value="1"/>
        <Setter TargetName="Hover" Property="Background" Value="{DynamicResource Brush.PressedOverlay}"/>
        <Setter TargetName="Root" Property="Effect" Value="{x:Null}"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
        <Setter TargetName="Hover" Property="Opacity" Value="0"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="Remy.Button.Base" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource Remy.SurfaceTemplate}"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="c:Ui.Radius" Value="11"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.BgCard}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}"/>
  </Style>
  <Style x:Key="Remy.SecondaryButton" TargetType="Button" BasedOn="{StaticResource Remy.Button.Base}">
    <Setter Property="FontWeight" Value="Medium"/>
  </Style>
  <Style x:Key="Remy.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Remy.Button.Base}">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Background" Value="{DynamicResource Brush.AccentDeep}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDeep}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
  </Style>
  <Style x:Key="Remy.DestructiveButton" TargetType="Button" BasedOn="{StaticResource Remy.SecondaryButton}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Destructive}"/>
  </Style>
  <Style x:Key="Remy.CompactButton" TargetType="Button" BasedOn="{StaticResource Remy.Button.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.BgInset}"/>
    <Setter Property="c:Ui.Radius" Value="8"/>
    <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Padding" Value="10,6"/>
  </Style>
  <Style x:Key="Remy.InsetButton" TargetType="Button" BasedOn="{StaticResource Remy.CompactButton}"/>
  <Style x:Key="Remy.IconButton" TargetType="Button" BasedOn="{StaticResource Remy.CompactButton}">
    <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Icons}"/><Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
  </Style>
  <Style x:Key="Remy.AddButton" TargetType="Button" BasedOn="{StaticResource Remy.Button.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.AddButtonFill}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDeep}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="c:Ui.Radius" Value="16"/>
    <Setter Property="Padding" Value="0,13"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource Remy.SecondaryButton}"/>

  <!-- ===== Switch (46x28, 22 knob, 3 inset) ===== -->
  <Style x:Key="Remy.Switch" TargetType="ToggleButton">
    <Setter Property="Width" Value="46"/><Setter Property="Height" Value="28"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid x:Name="Root" SnapsToDevicePixels="True">
            <Border x:Name="Track" CornerRadius="14" Background="{DynamicResource Brush.ToggleOff}"/>
            <Border x:Name="Focus" CornerRadius="16" Margin="-2" BorderThickness="2" BorderBrush="{DynamicResource Brush.AccentDeep}" Visibility="Collapsed"/>
            <Ellipse x:Name="Knob" Width="22" Height="22" Fill="{DynamicResource Brush.White}" HorizontalAlignment="Left" Margin="3,0,0,0">
              <Ellipse.Effect><DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="2" ShadowDepth="1" Direction="270"/></Ellipse.Effect>
            </Ellipse>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}"/>
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== TextBox (DSTextField) ===== -->
  <Style x:Key="Remy.TextBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/><Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Ink}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="Padding" Value="12,7"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <Border x:Name="Bd" Background="{DynamicResource Brush.BgCard}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="11">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="Ring" CornerRadius="11" BorderThickness="2" BorderBrush="{DynamicResource Brush.AccentDeep}" Visibility="Collapsed" IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource Remy.TextBox}"/>

  <!-- ===== ComboBox (DSDropdown) ===== -->
  <Style x:Key="Remy.ComboBoxItem" TargetType="ComboBoxItem">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/><Setter Property="FontSize" Value="13.5"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}"/>
    <Setter Property="Padding" Value="8,6"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Margin="4,1" Padding="{TemplateBinding Padding}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="Check" Text="&#xE73E;" Style="{StaticResource Text.Icon}" FontSize="11" Foreground="{DynamicResource Brush.AccentDeep}" Visibility="Hidden" VerticalAlignment="Center"/>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BorderSoft}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Remy.ComboBox" TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/><Setter Property="FontSize" Value="13.5"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="MinWidth" Value="120"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource Remy.ComboBoxItem}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Bd" Background="{DynamicResource Brush.BgInset}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="11"
                          Effect="{StaticResource Effect.Tactile}">
                    <Border x:Name="Hover" CornerRadius="11" Background="{DynamicResource Brush.HoverOverlay}" Opacity="0"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <Grid IsHitTestVisible="False" Margin="12,7">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center"/>
              <Path Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.4"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M0,3.5 L3,0.5 L6,3.5 M0,7.5 L3,10.5 L6,7.5"/>
            </Grid>
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                   PopupAnimation="None" VerticalOffset="4">
              <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,0,10,12"
                      Background="{DynamicResource Brush.BgCard}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="11" Padding="0,4">
                <Border.Effect><DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="12" ShadowDepth="3" Direction="270"/></Border.Effect>
                <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource Remy.ComboBox}"/>

  <!-- ===== Slider (DSSlider: 5px track, accent fill, 16px knob) ===== -->
  <Style x:Key="Remy.SliderFill" TargetType="RepeatButton">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
      <Border Height="5" Margin="8,0,0,0" CornerRadius="3,0,0,3" Background="{DynamicResource Brush.Accent}"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Remy.SliderRest" TargetType="RepeatButton">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" Height="16"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Remy.SliderKnob" TargetType="Thumb">
    <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
      <Ellipse Fill="{DynamicResource Brush.White}" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1">
        <Ellipse.Effect><DropShadowEffect Color="Black" Opacity="0.13" BlurRadius="3" ShadowDepth="1" Direction="270"/></Ellipse.Effect></Ellipse>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Remy.Slider" TargetType="Slider">
    <Setter Property="Height" Value="16"/><Setter Property="MinWidth" Value="100"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="Slider">
        <Grid x:Name="Root" Background="Transparent">
          <Border Height="5" CornerRadius="3" Background="{DynamicResource Brush.SliderTrackRest}" Margin="8,0"/>
          <Track x:Name="PART_Track">
            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Remy.SliderFill}" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Style="{StaticResource Remy.SliderKnob}"/></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Remy.SliderRest}" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider" BasedOn="{StaticResource Remy.Slider}"/>

  <!-- ===== Card, row, divider, chip, keycap ===== -->
  <Style x:Key="Remy.Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.BgCard}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/>
    <Setter Property="Effect" Value="{StaticResource Effect.Card}"/>
  </Style>
  <Style x:Key="Remy.Row" TargetType="Border"><Setter Property="Padding" Value="16,13"/></Style>
  <Style x:Key="Remy.DetailRow" TargetType="Border"><Setter Property="Padding" Value="16,14"/></Style>
  <Style x:Key="Remy.Divider" TargetType="Border">
    <Setter Property="Height" Value="1"/><Setter Property="Background" Value="{DynamicResource Brush.BorderSoft}"/>
  </Style>
  <Style x:Key="Remy.Chip" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.BgInset}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="999"/><Setter Property="Padding" Value="10,4"/><Setter Property="MaxWidth" Value="240"/>
  </Style>
  <Style x:Key="Remy.ChipSelected" TargetType="Border" BasedOn="{StaticResource Remy.Chip}">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentDeep}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style x:Key="Remy.Keycap" TargetType="ContentControl">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/><Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Brush.Ink}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
      <Border Background="{DynamicResource Brush.BgInset}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="10,6">
        <Border.Effect><DropShadowEffect Color="#808080" Opacity="0.45" BlurRadius="0" ShadowDepth="1.5" Direction="270"/></Border.Effect>
        <ContentPresenter HorizontalAlignment="Center"/>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- ===== ScrollBar (slim) ===== -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Grid Background="Transparent">
        <Track x:Name="PART_Track" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
            <Border Margin="2,0" CornerRadius="3" Background="{DynamicResource Brush.TextSecondary}" Opacity="0.45"/>
          </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton>
        </Track>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- ===== Tray context menu ===== -->
  <Style TargetType="ContextMenu" x:Key="Remy.ContextMenu">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/><Setter Property="FontSize" Value="13"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
      <Border Margin="0,0,10,12" Background="{DynamicResource Brush.BgCard}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="0,4">
        <Border.Effect><DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="12" ShadowDepth="3" Direction="270"/></Border.Effect>
        <ItemsPresenter/>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Separator" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
      <Border Height="1" Margin="10,4" Background="{DynamicResource Brush.BorderSoft}"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="MenuItem" x:Key="Remy.MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
      <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="4,1" Padding="8,6" SnapsToDevicePixels="True">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*" MinWidth="150"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="Check" Text="&#xE73E;" Style="{StaticResource Text.Icon}" FontSize="11" Foreground="{DynamicResource Brush.AccentDeep}" Visibility="Hidden" VerticalAlignment="Center"/>
          <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
          <TextBlock x:Name="Arrow" Grid.Column="2" Text="&#xE76C;" Style="{StaticResource Text.Icon}" FontSize="10" Visibility="Collapsed" VerticalAlignment="Center"/>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right" HorizontalOffset="-2" VerticalOffset="-6"
                 AllowsTransparency="True" Focusable="False" PopupAnimation="None">
            <Border Margin="0,0,10,12" Background="{DynamicResource Brush.BgCard}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="0,4">
              <Border.Effect><DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="12" ShadowDepth="3" Direction="270"/></Border.Effect>
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </Popup>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BorderSoft}"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- ===== Page scaffold (DSPage + DSSectionHeader) ===== -->
  <Style TargetType="c:PageScaffold">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="c:PageScaffold">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource Brush.BgWindow}" Focusable="False">
        <StackPanel MaxWidth="820" Margin="44,34,44,36" HorizontalAlignment="Stretch">
          <StackPanel Orientation="Horizontal">
            <Border Width="5" Height="22" CornerRadius="2" Background="{DynamicResource Brush.AccentDeep}" VerticalAlignment="Center" Margin="0,3,9,0"/>
            <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource Text.PageTitle}"/>
          </StackPanel>
          <TextBlock Text="{TemplateBinding Subtitle}" Style="{StaticResource Text.PageSubtitle}" Margin="0,5,0,24"/>
          <ContentPresenter/>
        </StackPanel>
      </ScrollViewer>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- ===== Section (DSSection: overline over content, 10 gap) ===== -->
  <Style TargetType="c:Section">
    <Setter Property="Margin" Value="0,0,0,24"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="c:Section">
      <StackPanel>
        <c:TrackedText Text="{TemplateBinding Overline}" Style="{StaticResource Overline}" Margin="0,0,0,10"/>
        <ContentPresenter/>
      </StackPanel>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- ===== Status pill / model readiness badge ===== -->
  <Style TargetType="c:StatusPill">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/><Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="c:StatusPill">
      <Border x:Name="Bd" CornerRadius="999" Padding="10,4" Background="{DynamicResource Brush.SuccessSoft}">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource Brush.Success}" Margin="0,0,6,0"/>
          <TextBlock x:Name="Tx" Text="{TemplateBinding Text}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                     FontWeight="{TemplateBinding FontWeight}" Foreground="{DynamicResource Brush.SuccessText}"/>
        </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="Kind" Value="Neutral">
          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BgInset}"/>
          <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.TextSecondary}"/>
          <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
