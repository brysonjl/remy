<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Remy.App.Controls">
  <!-- Type scale from parity/ui.md 1.3. UI = Segoe UI Variable, display = Segoe UI Variable Display, mono = Cascadia Mono. -->
  <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
  <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <Style x:Key="Text.Base" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Text.PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
    <Setter Property="FontSize" Value="27"/><Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
  </Style>
  <Style x:Key="Text.PageSubtitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
  </Style>
  <Style x:Key="Text.RowLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontWeight" Value="Medium"/>
  </Style>
  <Style x:Key="Text.RowValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
  </Style>
  <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="LineHeight" Value="17"/>
  </Style>
  <Style x:Key="Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
    <Setter Property="FontSize" Value="10"/>
  </Style>
  <Style x:Key="Text.Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Icons}"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    <Setter Property="TextAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Overline" TargetType="c:TrackedText">
    <Setter Property="FontSize" Value="10.5"/><Setter Property="Tracking" Value="1.1"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
  </Style>
</ResourceDictionary>
